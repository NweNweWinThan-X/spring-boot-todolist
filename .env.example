# docker compose / local runtime environment.
# Copy to .env and fill in real values. Never commit .env.
DB_USERNAME=todolist
DB_PASSWORD=
IMAGE_VERSION=latest

# Required by docker compose. Generate one with: openssl rand -base64 48
JWT_SECRET=

# URL the browser uses to reach the API; baked into the SPA bundle at build time.
API_BASE_URL=http://localhost:9002/api/v1

# Bootstrap admin account, created on startup by the "local" profile only.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
