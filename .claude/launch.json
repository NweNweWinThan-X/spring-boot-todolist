{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-h2",
      "runtimeExecutable": "./mvnw",
      "runtimeArgs": [
        "spring-boot:run",
        "-Dspring-boot.run.profiles=h2"
      ],
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": false
    }
  ]
}
