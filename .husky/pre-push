#!/bin/sh
#
# 保護ブランチへの直接プッシュを拒否する。
#
# git は push しようとしている ref を1行ずつ標準入力で渡す:
#   <local ref> <local sha> <remote ref> <remote sha>
#
# 判定には「送り先の ref」を使う。チェックアウト中のブランチ (HEAD) で判定すると、
# 別のブランチから `git push origin main:develop` のように送った場合に素通りし、
# 逆に develop にいるだけで無関係なブランチの push まで止めてしまう。
#
# local sha が全ゼロの行は削除要求。保護ブランチの削除も同様に拒否する。

blocked=0

# `|| [ -n "$local_ref" ]` は最終行に改行がない場合の取りこぼしを防ぐ。
# read は改行を読まずに EOF に達すると偽を返すが、変数には値が入っている。
while read -r local_ref local_sha remote_ref remote_sha || [ -n "$local_ref" ]; do
  # ブランチ以外 (タグなど) は対象外
  case "$remote_ref" in
    refs/heads/*) branch=${remote_ref#refs/heads/} ;;
    *) continue ;;
  esac

  case "$branch" in
    develop*|release*) ;;
    *) continue ;;
  esac

  case "$local_sha" in
    *[!0]*) echo "❌ ブランチ保護エラー: '$branch' への直接プッシュは許可されていません。" ;;
    *)      echo "❌ ブランチ保護エラー: '$branch' の削除は許可されていません。" ;;
  esac
  blocked=1
done

if [ "$blocked" -ne 0 ]; then
  echo "   作業ブランチを作成し、マージリクエスト経由でのマージをお願いします。"
  exit 1
fi
